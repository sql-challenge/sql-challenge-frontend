# Local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_PORT=3002

# Firebase Emulator (dev) — true enquanto os emuladores rodam no backend
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase (Client SDK) — em dev o projeto é o namespace local dos
# emuladores (prefixo demo- nunca toca a nuvem). Os valores reais ficam
# apenas nos builds de deploy (Dockerfile ARGs / .env.production).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sql-challenge.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sql-challenge
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sql-challenge.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=demo-sender
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
